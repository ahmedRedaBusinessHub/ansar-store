# web-api origin (server-side only, never sent to the browser). No trailing slash.
ANSAR_API_BASE_URL=http://127.0.0.1:3000
# This storefront's public origin; Moyasar redirects the shopper back here after 3-D Secure.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3017
# Moyasar PUBLISHABLE key (pk_test_… / pk_live_…). Must belong to the same Moyasar account as web-api's MOYASAR_SECRET_KEY.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_replace_me
# Moyasar form methods. STC Pay is on unless set to 0. Apple Pay stays off until the storefront's HTTPS domain
# is registered in Moyasar Dashboard → Settings → Apple Pay Domains (see README "Apple Pay").
NEXT_PUBLIC_STCPAY_ENABLED=1
NEXT_PUBLIC_APPLE_PAY_ENABLED=0
# Merchant name shown on the Apple Pay sheet
NEXT_PUBLIC_APPLE_PAY_LABEL=نادي الأنصار
